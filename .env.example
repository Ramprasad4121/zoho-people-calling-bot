# --- Required for phone calls -------------------------------------------------
# Used by the browser console to authorize call creation and transcript reads.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CALL_API_TOKEN=replace-with-a-long-random-token

# Twilio credentials. Never put these in frontend code or commit this file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL of this service (Cloudflare/ngrok tunnel).
# The app probes this URL before every call; Twilio must be able to fetch it.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Voice used by Twilio Say. Polly.Aditi is Hindi/English (India); "alice" is a safe fallback.
TWILIO_VOICE=Polly.Aditi

# Verify X-Twilio-Signature on every callback. Keep enabled in production.
TWILIO_VERIFY_SIGNATURES=true

# Local/test only: skip DNS+HTTP webhook reachability probe before dialing.
SKIP_WEBHOOK_PREFLIGHT=false

# --- LLM provider -------------------------------------------------------------
# OpenAI, Groq, OpenRouter or any OpenAI-compatible endpoint.
OPENAI_API_KEY=sk-your-openai-key
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# Keep below Twilio's ~15s webhook deadline. Values are clamped to 2-12 seconds.
LLM_TIMEOUT_SECONDS=8

# --- Optional: Calendly demo booking -----------------------------------------
# PAT with scheduled_events:write + event_types:read scopes.
CALENDLY_ACCESS_TOKEN=
# Canonical URI: https://api.calendly.com/event_types/<uuid>
CALENDLY_EVENT_TYPE_URI=
# Timezone used when reading slot labels aloud.
CALENDLY_DISPLAY_TIMEZONE=Asia/Kolkata
# Timezone sent for the invitee when booking.
CALENDLY_INVITEE_TIMEZONE=Asia/Kolkata
# Set only if the event type requires a location kind, e.g. google_conference.
CALENDLY_LOCATION_KIND=

# --- Optional: live human handoff --------------------------------------------
# E.164 number of the Interloop colleague prospects are transferred to.
HANDOFF_PHONE_NUMBER=

# --- Optional: lead export and hardening -------------------------------------
# HTTPS receiver for finished leads. Private IPs are blocked unless explicitly allowed.
SALES_WEBHOOK_URL=
# ALLOW_PRIVATE_WEBHOOK=true
# ALLOWED_ORIGINS=https://console.example.com
RATE_LIMIT_ENABLED=true
RESEARCH_CACHE_TTL_SECONDS=3600
