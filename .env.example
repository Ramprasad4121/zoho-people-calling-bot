# LLM Provider (OpenAI, Groq, or OpenRouter)
OPENAI_API_KEY=sk-your-openai-key
# To use Groq instead of OpenAI, uncomment the lines below (free key: https://console.groq.com/keys):
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# To use OpenRouter free models instead, uncomment these lines (free key: https://openrouter.ai/keys).
# The app sends reasoning.effort=none so the reply is spoken text, not hidden thinking.
# LLM_API_KEY=sk-or-v1-your-openrouter-key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Twilio Credentials (for real outbound phone calls)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL (from ngrok, e.g. https://abc123.ngrok-free.app)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app

# Optional: POST each finished browser lead as JSON to any free webhook receiver
SALES_WEBHOOK_URL=
